#include <stdio.h>

int main() {
    int arr[100] = {10, 20, 30, 40, 50}; 
    int size = 5;       
    int element = 99;  
    int index = 2;     
    for (int i = size - 1; i >= index; i--) {
        arr[i + 1] = arr[i];
    }
    arr[index] = element;
    size++;
    printf("Array after insertion: ");
    for (int i = 0; i < size; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");
    return 0;
}
