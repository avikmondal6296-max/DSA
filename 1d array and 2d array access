#include <stdio.h>

int main() {
    int list[3] = {10, 20, 30};

    int grid[2][3] = {
        {1, 2, 3},
        {4, 5, 6}
    };

    printf("Single element from 1D array (index 1): %d\n", list[1]);
    printf("Single element from 2D array (row 1, col 2): %d\n\n", grid[1][2]);

    printf("All elements in 1D array:\n");
    for (int i = 0; i < 3; i++) {
        printf("%d ", list[i]);
    }
    printf("\n\n");

    printf("All elements in 2D array:\n");
    for (int row = 0; row < 2; row++) {
        for (int col = 0; col < 3; col++) {
            printf("%d ", grid[row][col]);
        }
        printf("\n");
    }

    return 0;
}
