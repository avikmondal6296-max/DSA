#include <stdio.h>

int main() {
    int arr = {10, 20, 30, 40, 50};
    int size = 5;
    int target = 40; 
    int found_index = -1; 
    for (int i = 0; i < size; i++) {
        if (arr[i] == target) {
            found_index = i; 
            break;          
        }
    }
    if (found_index != -1) {
        printf("Element found at index: %d\n", found_index);
    } else {
        printf("Element not found in the array.\n");
    }

    return 0;
}
