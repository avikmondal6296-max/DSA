#include <stdio.h>

int main() {
    int list[3] = {10, 20, 30};
    
    printf("--- 1D Array (Simple List) ---\n");
    for (int i = 0; i < 3; i++) {
        printf("Element at index %d = %d\n", i, list[i]);
    }
    
    printf("\n");

    int grid[2][3] = {
        {1, 2, 3},
        {4, 5, 6}
    };
    
    printf("--- 2D Array (Table / Grid) ---\n");
    for (int row = 0; row < 2; row++) {
        for (int col = 0; col < 3; col++) {
            printf("%d ", grid[row][col]);
        }
        printf("\n");
    }

    return 0;
}
